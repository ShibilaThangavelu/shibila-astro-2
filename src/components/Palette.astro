<div class="pal" id="pal" hidden>
  <div class="pbox" role="dialog" aria-modal="true" aria-label="Command palette">
    <input id="palq" type="text" placeholder="Jump to a section, run a demo, copy my email" autocomplete="off" spellcheck="false" aria-label="Search commands">
    <ul class="plist" id="plist" role="listbox"></ul>
    <div class="pfoot">Up and down to move, Enter to run, Esc to close</div>
  </div>
</div>
<div class="toast" id="toast" role="status"></div>
