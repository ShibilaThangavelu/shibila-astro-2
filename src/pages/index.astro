---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Glance from '../components/Glance.astro';
import Demo from '../components/Demo.astro';
import Work from '../components/Work.astro';
import Numbers from '../components/Numbers.astro';
import Marquee from '../components/Marquee.astro';
import Stack from '../components/Stack.astro';
import Record from '../components/Record.astro';
import Practice from '../components/Practice.astro';
import Contact from '../components/Contact.astro';
import Palette from '../components/Palette.astro';
---
<Base title="Shibila Thangavelu">
  <div class="wrap">
    <Nav />
    <main id="top">
      <Hero />
      <Glance />
      <Demo />
      <Work />
      <Numbers />
      <Marquee />
      <Stack />
      <Record />
      <Practice />
      <Contact />
    </main>
  </div>
  <Palette />
</Base>
